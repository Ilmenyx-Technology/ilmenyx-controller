<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.30.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ilmenyx.Contracts/Ilmenyx.Contracts.csproj" />
    <ProjectReference Include="../Ilmenyx.Core/Ilmenyx.Core.csproj" />
    <ProjectReference Include="../Ilmenyx.Platform.Linux/Ilmenyx.Platform.Linux.csproj" />
    <ProjectReference Include="../Ilmenyx.Gpu.Vulkan/Ilmenyx.Gpu.Vulkan.csproj" />
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Identidade visual oficial: ícone da janela e símbolo do cabeçalho. -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <!-- Pacote autocontido (scripts/package-linux-x64.sh): runtime e ICU acompanham o app. -->
  <PropertyGroup Condition="'$(IlmenyxBundleIcu)' == 'true'">
    <IlmenyxIcuVersion>72.1.0.3</IlmenyxIcuVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(IlmenyxBundleIcu)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="$(IlmenyxIcuVersion)" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(IlmenyxIcuVersion)" />
  </ItemGroup>
</Project>
