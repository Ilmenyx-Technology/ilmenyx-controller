// Adapted from RESET EXPLODE GpuRtBench.cs (MIT, Copyright (c) 2026 Gustavo (GustavoReset)): GLSL translation of the original HLSL inline-ray path tracer
// (DXR 1.1 RayQuery -> GL_EXT_ray_query). Same rays per sample: visibility/bounce + soft sun shadow + ambient occlusion. See NOTICE.md.
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform Frame {
    mat4 invViewProj;          // System.Numerics row-vector matrix uploaded as is: invViewProj * v == v * M
    vec4 camPosTime;           // xyz camera, w seconds
    vec4 sunDirFrame;          // xyz sun direction, w = frame index stored as raw uint bits
    uvec4 sizeQuality;         // width, height, spp, bounces
    uvec4 band;                // first row, rows (probe frames render only a band)
} F;

layout(set = 0, binding = 0) uniform accelerationStructureEXT Scene;
layout(set = 0, binding = 1, std430) readonly buffer Verts { float v[]; };       // pos.xyz, nrm.xyz (24-byte stride, the BLAS input)
layout(set = 0, binding = 2, std430) readonly buffer Indices { uint idx[]; };
layout(set = 0, binding = 3, std430) readonly buffer Meshes { uvec4 meshes[]; }; // indexOffset, vertexOffset, -, -
struct Inst { vec3 albedo; float metal; float rough; float emissive; uint mesh; float pad; };
layout(set = 0, binding = 4, std430) readonly buffer Insts { Inst insts[]; };
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D Output;

uint Pcg(inout uint s) { s = s * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
float Rnd(inout uint s) { return float(Pcg(s) & 0xFFFFFFu) / 16777216.0; }

vec3 CosineDir(vec3 n, inout uint s)
{
    float u = Rnd(s), vv = Rnd(s), r = sqrt(u), phi = 6.2831853 * vv;
    vec3 t = abs(n.y) < 0.99 ? normalize(cross(n, vec3(0, 1, 0))) : vec3(1, 0, 0);
    vec3 b = cross(n, t);
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u)));
}

vec3 Sky(vec3 d)
{
    vec3 sunDir = F.sunDirFrame.xyz;
    vec3 sky = mix(vec3(0.85, 0.9, 1.0), vec3(0.25, 0.45, 0.85), clamp(d.y, 0.0, 1.0));
    float sun = pow(clamp(dot(d, -sunDir), 0.0, 1.0), 900.0) * 60.0;
    return sky * 0.8 + sun * vec3(1.0, 0.92, 0.8);
}

vec3 Normal(uint vertex) { uint b = vertex * 6u; return vec3(v[b + 3u], v[b + 4u], v[b + 5u]); }

bool Closest(vec3 o, vec3 d, out vec3 pos, out vec3 nrm, out Inst m)
{
    rayQueryEXT q;
    rayQueryInitializeEXT(q, Scene, gl_RayFlagsOpaqueEXT, 0xFF, o, 0.002, d, 2000.0);
    while (rayQueryProceedEXT(q)) { }
    pos = vec3(0); nrm = vec3(0, 1, 0); m = insts[0];
    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return false;
    m = insts[rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)];
    uvec4 me = meshes[m.mesh];
    uint i0 = me.x + uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)) * 3u;
    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(q, true);
    vec3 n = Normal(me.y + idx[i0]) * (1.0 - bc.x - bc.y) + Normal(me.y + idx[i0 + 1u]) * bc.x + Normal(me.y + idx[i0 + 2u]) * bc.y;
    mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(q, true);
    n = normalize(mat3(o2w) * n);
    if (dot(n, d) > 0.0) n = -n;
    pos = o + d * rayQueryGetIntersectionTEXT(q, true) + n * 0.003;
    nrm = n;
    return true;
}

bool Occluded(vec3 o, vec3 d, float tmax)
{
    rayQueryEXT q;
    rayQueryInitializeEXT(q, Scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, o, 0.002, d, tmax);
    while (rayQueryProceedEXT(q)) { }
    return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main()
{
    uvec2 id = uvec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y + F.band.x);
    uint width = F.sizeQuality.x, height = F.sizeQuality.y, spp = F.sizeQuality.z, bounces = F.sizeQuality.w;
    if (id.x >= width || id.y >= height || gl_GlobalInvocationID.y >= F.band.y) return;
    vec3 sunDir = F.sunDirFrame.xyz;
    uint seed = (id.y * width + id.x) * 9781u + floatBitsToUint(F.sunDirFrame.w) * 6271u;
    vec3 color = vec3(0);
    for (uint s = 0u; s < spp; s++)
    {
        vec2 uv = (vec2(id) + vec2(Rnd(seed), Rnd(seed))) / vec2(width, height);
        vec4 p = F.invViewProj * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 1.0, 1.0);
        vec3 o = F.camPosTime.xyz, d = normalize(p.xyz / p.w - F.camPosTime.xyz);
        vec3 through = vec3(1), acc = vec3(0);
        for (uint b = 0u; b < bounces; b++)
        {
            vec3 hp, hn; Inst m;
            if (!Closest(o, d, hp, hn, m)) { acc += through * Sky(d); break; }
            acc += through * m.albedo * m.emissive;
            // Soft sun shadow (direction jittered in a cone) + ambient occlusion (one hemisphere ray).
            vec3 sd = normalize(-sunDir + (vec3(Rnd(seed), Rnd(seed), Rnd(seed)) - 0.5) * 0.06);
            float ndl = clamp(dot(hn, sd), 0.0, 1.0);
            float sunVis = ndl > 0.0 && !Occluded(hp, sd, 1000.0) ? 1.0 : 0.0;
            vec3 ad = CosineDir(hn, seed);
            float ao = Occluded(hp, ad, 6.0) ? 0.15 : 1.0;
            vec3 diffuse = m.albedo * (1.0 - m.metal);
            acc += through * diffuse * (ndl * sunVis * vec3(3.6, 3.3, 2.9) + ao * vec3(0.12, 0.15, 0.2));
            // Next bounce: reflection (metal) or indirect light (diffuse).
            if (m.metal > 0.5)
            {
                vec3 rd = reflect(d, hn);
                d = normalize(rd + (CosineDir(hn, seed) - hn) * m.rough);
                through *= m.albedo;
            }
            else
            {
                d = CosineDir(hn, seed);
                through *= m.albedo * 0.8;
            }
            o = hp;
            if (max(through.x, max(through.y, through.z)) < 0.02) break;
        }
        color += acc;
    }
    color /= float(spp);
    color = color / (1.0 + color);                       // tone mapping (Reinhard)
    color = pow(clamp(color, 0.0, 1.0), vec3(1.0 / 2.2)); // gamma
    imageStore(Output, ivec2(id), vec4(color, 1.0));
}
