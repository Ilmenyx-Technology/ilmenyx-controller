<!-- SPDX-FileCopyrightText: 2026 Flávio (mantido como Bismuth Technology) -->
<Project>
  <PropertyGroup>
    <Product>Ilmenyx</Product>
    <Company>Bismuth Technology</Company>
    <Description>Independent, unofficial Linux adaptation of RESET EXPLODE by Gustavo (GustavoReset). Hardware diagnostics, monitoring and experimental benchmarking.</Description>
    <PackageLicenseFile>LICENSING.md</PackageLicenseFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../LICENSING.md" Link="LICENSING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSES/*.txt" Link="LICENSES/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
